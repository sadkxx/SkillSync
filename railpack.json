{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "steps": {
    "install": {
      "commands": [
        "cd backend && python -m venv /app/.venv",
        "cd backend && /app/.venv/bin/pip install -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && /app/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}
