{
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "cd backend && /app/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
